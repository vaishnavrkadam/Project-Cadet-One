rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isANO() {
      return isAuthenticated() && 
        (request.auth.token.email.lower() == "vaishnavkadam57@gmail.com" ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "ANO"));
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || isANO());
    }

    // Cadets Nominal Roll
    match /cadets/{cadetId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isANO();
    }

    // Attendance records
    match /attendance/{recordId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isANO();
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isANO();
    }

    // Resources
    match /resources/{resourceId} {
      allow read: if isAuthenticated();
      allow create, update: if isANO() || 
        (isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "Senior");
      allow delete: if isANO();
    }

    // Exam Questions Bank
    match /examQuestions/{questionId} {
      allow read: if isAuthenticated();
      allow write: if isANO();
    }

    // Exam Attempts & Progress
    match /examAttempts/{attemptId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.cadetEmail.lower() == request.auth.token.email.lower();
      allow update, delete: if isANO();
    }

    // Cadet Progress Tracking
    match /progress/{cadetId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == cadetId || isANO());
    }
  }
}
